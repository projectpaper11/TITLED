  m_Script: {fileID: 11500000, guid: d12eab80627a4b379e8af4fe57c265ea, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UI.OpenCloseMenu
  handUI: {fileID: 356335432}
  targetVolume: {fileID: 822595846}
  lightImage: {fileID: 68085193}
  writer: {fileID: 50530319}
  ments:
  - "\uB9F5\uC5D0 \uC788\uB294 \uC7A5\uCE58\uB4E4\uC744 5\uAC1C \uBD80\uC218\uC2DC\uBA74
    \uBB38\uC774 \uC5F4\uB9B4 \uAC81\uB2C8\uB2E4!"
  - "\uB178\uC774\uC988.. \uC0AC\uB78C \uD615\uCC44\uC758 \uADF8\uB294 \uB2E8\uC21C\uD788
    \uBE5B\uB9CC \uBE44\uCD94\uBA74 \uB418\uB294 \uAC00\uC7A5 \uC26C\uC6B4 \uAD34\uBB3C
    \uC785\uB2C8\uB2E4."
  - "\uC5B4\uB54C\uC694? \uC774\uACF3 \uC0DD\uD65C\uC740 \uB9C8\uC74C\uC5D0 \uB4DC\uC2DC\uB098\uC694?"
  - "\uB3C4\uC800.. \uD574\uB97C \uBCF8\uB72C \uAD34\uBB3C\uC740 \uB2F9\uC2E0\uC758
    \uBE5B\uC744 \uD53C\uD574 \uC6C0\uC9C1\uC774\uC8E0."
  - "\uC2A4\uC704\uCC98.. \uADF8\uB294 \uB2F9\uC2E0\uC744 \uBCF4\uB294 \uC21C\uAC04
    \uB2F9\uC2E0\uC758 \uBE5B\uC744 \uBC18\uB300\uB85C \uAD74\uC808 \uC2DC\uD0A4\uC8E0."
  - "\uC5F4\uB9B0 \uBB38 \uB610\uD55C \uACC4\uC18D \uC5F4\uB824\uC788\uC9C0\uB9CC\uC740
    \uC54A\uC8E0. "
  - "[\uD3B8\uC9D1\uB428][\uD3B8\uC9D1\uB428][\uD3B8\uC9D1\uB428][\uD3B8\uC9D1\uB428][\uD3B8\uC9D1\uB428][\uD3B8\uC9D1\uB428][\uD3B8\uC9D1\uB428][\uD3B8\uC9D1\uB428][\uD3B8\uC9D1\uB428][\uD3B8\uC9D1\uB428][\uD3B8\uC9D1\uB428][\uD3B8\uC9D1\uB428][\uD3B8\uC9D1\uB428][\uD3B8\uC9D1\uB428][\uD3B8\uC9D1\uB428][\uD3B8\uC9D1\uB428][\uD3B8\uC9D1\uB428][\uD3B8\uC9D1\uB428]"
  - "\uB2E4\uC74C \uD504\uB85C\uC81D\uD2B8\uBA85. UNTITLED.. \uC608? \uC544\uB2C8\uC694.
    \uC544\uBB34\uAC83\uB3C4 \uC544\uB2D9\uB2C8\uB2E4."
